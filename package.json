{
  "name": "json-rescue",
  "version": "0.2.2",
  "description": "Rescue valid JSON from messy text by extracting candidates, applying safe repairs, and returning a parsed result with a transparent repair report.",
  "keywords": [
    "json",
    "parsing",
    "repair",
    "typescript"
  ],
  "homepage": "https://github.com/azeemmirza/json-rescue#readme",
  "bugs": {
    "url": "https://github.com/azeemmirza/json-rescue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azeemmirza/json-rescue.git"
  },
  "license": "MIT",
  "author": {
    "name": "Azeem Mirza",
    "url": "https://azeemmirza.co"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepublishOnly": "npm run build && npm run lint && npm run test",
    "publish": "npm publish --access public"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "release-it": "^19.2.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
